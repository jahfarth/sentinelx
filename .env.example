# SentinelX environment configuration — copy to .env and fill in secrets.
# NEVER commit a real .env file.

# --- Core ---
SENTINELX_ENV=dev
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@postgres:5432/sentinelx
REDIS_URL=redis://redis:6379/0

# --- Threat intel (leave empty to run in mock mode) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
SENTINELX_INTEL_MOCK=1

# --- Automated response ---
SENTINELX_DRY_RUN=1            # 1 = log actions only, 0 = really run iptables
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ---
VITE_API_URL=http://localhost:8000
