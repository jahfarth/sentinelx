# Base URL for the SentinelX API.
#
# Leave empty to use same-origin requests:
#   - `npm run dev`  -> vite dev proxy forwards /api and /healthz to http://localhost:8000
#   - production     -> nginx proxies /api/ and /healthz to the `api` service
#
# Set this when the dashboard is served from a different origin than the API,
# e.g. VITE_API_URL=http://localhost:8000
VITE_API_URL=
